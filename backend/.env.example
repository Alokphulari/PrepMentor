PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Question generation, resume analysis, and general voice features.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_BASE_URL=https://api.openai.com/v1

# Interview sessions default to Gemini. Set INTERVIEW_AI_PROVIDER=openai
# or openrouter if you want to use the corresponding provider instead.
INTERVIEW_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_INTERVIEW_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Legacy LLM_* variables are still supported for existing deployments.
