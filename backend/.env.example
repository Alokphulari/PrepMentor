# Node 24 recommended. Restart the API after editing backend/.env.
PORT=4000
# Exact browser origin; no trailing slash. Use your HTTPS Vercel origin in production.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Blank uses local JSON in development; production requires MongoDB.
MONGODB_URI=
MONGODB_DB_NAME=prepmentor
# openai uses Responses API; openrouter uses Chat Completions for text only.
AI_PROVIDER=openai
# Private server key from your OpenAI API project. Never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Choose a Responses/JSON-compatible model available to your account, e.g. gpt-5-mini.
OPENAI_LLM_MODEL=
# File transcription, e.g. gpt-4o-mini-transcribe. Blank disables backend STT.
OPENAI_STT_MODEL=
# Speech generation, e.g. gpt-4o-mini-tts. Blank disables backend TTS.
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=alloy
# Optional alternative LLM provider. Speech still uses OPENAI_* settings.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=
# Judge0 CE base URL without /submissions. Blank disables execution.
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
# Set only for RapidAPI; otherwise the key uses the X-Auth-Token header.
JUDGE0_RAPIDAPI_HOST=
# Optional OAuth web client ID; use the same public ID in frontend/.env.
GOOGLE_CLIENT_ID=
# Legacy LLM_API_KEY / LLM_BASE_URL / LLM_MODEL / LLM_TRANSCRIPTION_MODEL /
# LLM_TTS_MODEL / LLM_TTS_VOICE are accepted when OPENAI_* is absent.

# Primary provider for the Interview module only
INTERVIEW_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_INTERVIEW_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Use the deterministic local interview engine without any Gemini calls.
INTERVIEW_DEMO_MODE=false
